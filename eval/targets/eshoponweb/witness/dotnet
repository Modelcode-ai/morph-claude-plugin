#!/bin/sh
# dotnet from the SDK 11 image (the host has SDK 10). The checkout is mounted at its own path so host paths in args stay valid.
# DOTNET_PUBLISH=<port> publishes that port on 127.0.0.1. Env vars matching FORWARD are passed into the container.
root=$(cd "$(dirname "$0")/.." && pwd)
FORWARD='^(WITNESS_[A-Z0-9_]*|ASPNETCORE_[A-Za-z0-9_]*|UseOnlyInMemoryDatabase|baseUrls__[A-Za-z0-9_]*|ESHOP_[A-Za-z0-9_]*)='
envfile=$(mktemp "${TMPDIR:-/tmp}/witness-dn-env.XXXXXX")
env | grep -E "$FORWARD" > "$envfile"
name="witness-dn-$$-$(date +%s)"
publish=""
extra=""
# --against runs a checkout elsewhere while its run dir stays in the target checkout
case "$WITNESS_RUN_DIR" in ""|"$root"/*) ;; *) extra="-v $WITNESS_RUN_DIR:$WITNESS_RUN_DIR" ;; esac
[ -n "$DOTNET_PUBLISH" ] && publish="-p 127.0.0.1:$DOTNET_PUBLISH:$DOTNET_PUBLISH"
cleanup() { docker rm -f "$name" >/dev/null 2>&1; rm -f "$envfile"; }
trap 'cleanup; exit 143' TERM INT
docker run --rm --init --name "$name" $publish --env-file "$envfile" \
  -e DOTNET_CLI_TELEMETRY_OPTOUT=1 -e DOTNET_NOLOGO=1 -e DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
  -v "$root:$root" $extra -v eshop-nuget:/root/.nuget/packages -w "$PWD" \
  mcr.microsoft.com/dotnet/sdk:11.0 dotnet "$@" &
child=$!
wait $child
code=$?
cleanup
exit $code
