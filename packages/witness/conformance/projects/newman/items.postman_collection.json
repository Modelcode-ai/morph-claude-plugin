{
  "info": {
    "name": "Witness kit",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "list items",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"lists items\", function () {",
              "    pm.response.to.have.status(200);",
              "    pm.expect(pm.response.json().map((i) => i.name)).to.eql([\"apple\", \"pear\"]);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ]
        }
      }
    },
    {
      "name": "get item",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"item name\", function () {",
              "    pm.expect(pm.response.json().name).to.eql(\"banana\");",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items",
            "1"
          ]
        }
      }
    },
    {
      "name": "skipped",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test.skip(\"skipped\", function () {",
              "    pm.response.to.have.status(200);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/items",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "items"
          ]
        }
      }
    },
    {
      "name": "hang",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.variables.set(\"itemsPath\", pm.environment.get(\"hang\") === \"1\" ? \"hang\" : \"items\");"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.environment.get(\"hang\") === \"1\") {",
              "    pm.test(\"hangs\", function () {",
              "        pm.response.to.have.status(200);",
              "    });",
              "} else {",
              "    pm.test.skip(\"hangs\", function () {});",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/{{itemsPath}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "{{itemsPath}}"
          ]
        }
      }
    }
  ]
}