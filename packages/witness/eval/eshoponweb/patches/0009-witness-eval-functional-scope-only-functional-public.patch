From 194d28214cc003094e84458c1e0b6972acb56722 Mon Sep 17 00:00:00 2001
From: dserebro <dserebro@modelcode.ai>
Date: Mon, 23 Nov 2026 10:46:37 -0800
Subject: [PATCH 9/9] witness eval: functional scope only (functional,
 publicapi, e2e); e2e runs on the host with SDK 11 against the web container's
 published port

---
 .witness/dotnet-host  |  9 +++++++++
 .witness/witness.toml | 31 +++++++++----------------------
 2 files changed, 18 insertions(+), 22 deletions(-)
 create mode 100755 .witness/dotnet-host

diff --git a/.witness/dotnet-host b/.witness/dotnet-host
new file mode 100755
index 0000000..7bcc62a
--- /dev/null
+++ b/.witness/dotnet-host
@@ -0,0 +1,9 @@
+#!/bin/sh
+# dotnet from a host SDK 11 at $DOTNET_HOST_ROOT, for suites whose browser runs on the host (the app stays in .witness/dotnet).
+# Its own artifacts path keeps host builds out of the bin/ and obj/ that the container builds use.
+root=$(cd "$(dirname "$0")/.." && pwd)
+: "${DOTNET_HOST_ROOT:?set DOTNET_HOST_ROOT to an SDK 11 install, in .witness/.env}"
+export DOTNET_ROOT="$DOTNET_HOST_ROOT" DOTNET_CLI_TELEMETRY_OPTOUT=1 DOTNET_NOLOGO=1
+verb=$1
+shift
+exec "$DOTNET_HOST_ROOT/dotnet" "$verb" --artifacts-path "$root/.witness/cache/host-artifacts" "$@"
diff --git a/.witness/witness.toml b/.witness/witness.toml
index 7651e06..fa1eb5e 100644
--- a/.witness/witness.toml
+++ b/.witness/witness.toml
@@ -1,9 +1,11 @@
-# eShopOnWeb under witness. dotnet runs in the SDK 11 image through .witness/dotnet (the host has SDK 10).
+# eShopOnWeb under witness: the functional suites only (in-process HTML, in-process API, Playwright e2e).
+# The app and the in-process suites run in the SDK 11 image through .witness/dotnet (the host has SDK 10).
+# e2e runs on the host through .witness/dotnet-host (SDK 11 at DOTNET_HOST_ROOT), against the app's published port.
 version = 1
 
 [env]
 file = ".witness/.env"
-required = []
+required = ["DOTNET_HOST_ROOT"]
 
 [[service]]
 name = "web"
@@ -13,22 +15,6 @@ start = ".witness/dotnet run --no-build --no-launch-profile --project src/Web/We
 env = { UseOnlyInMemoryDatabase = "true", ASPNETCORE_ENVIRONMENT = "Development", DOTNET_PUBLISH = "${PORT}" }
 ready = { http = "${self.url}/home_page_health_check", status = 200, timeout = "180s" }
 
-[[suite]]
-name = "unit"
-adapter = "dotnet"
-cwd = "."
-cmd = ".witness/dotnet test --project tests/UnitTests/UnitTests.csproj"
-service = []
-timeout = "20m"
-
-[[suite]]
-name = "integration"
-adapter = "dotnet"
-cwd = "."
-cmd = ".witness/dotnet test --project tests/IntegrationTests/IntegrationTests.csproj"
-service = []
-timeout = "20m"
-
 [[suite]]
 name = "functional"
 adapter = "dotnet"
@@ -46,12 +32,13 @@ service = []
 timeout = "20m"
 
 [[suite]]
-name = "smoke-http"
-adapter = "generic"
+name = "e2e"
+adapter = "dotnet"
 cwd = "."
-cmd = "curl -fsS ${web.url}/ | grep -qi catalog"
+cmd = ".witness/dotnet-host test --project tests/EndToEndTests/EndToEndTests.csproj"
 service = ["web"]
-timeout = "2m"
+env = { E2E_BASE_URL = "${web.url}" }
+timeout = "10m"
 
 [run]
 stall_timeout = "5m"
