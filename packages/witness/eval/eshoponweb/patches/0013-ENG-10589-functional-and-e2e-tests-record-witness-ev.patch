+using System.Diagnostics;
+using System.Text.Json;
+using System.Text.RegularExpressions;
+using Xunit;
+
+namespace Microsoft.eShopWeb.FunctionalTests.Web;
+
+/// <summary>Witness evidence: what the running test sent and saw, appended to its timeline. A no-op outside a witness run.</summary>
+public static class WitnessEvidence
+{
+    private const int Limit = 64 * 1024;
+    private static readonly HashSet<string> Secret = new(StringComparer.OrdinalIgnoreCase) { "Authorization", "Cookie", "Set-Cookie" };
+    private static readonly object Gate = new();
+
+    public static void Record(string kind, object data, string? step = null)
+    {
+        var root = Environment.GetEnvironmentVariable("WITNESS_ARTIFACTS");
+        var test = TestContext.Current.Test?.TestDisplayName;
+        if (string.IsNullOrEmpty(root) || test is null) return;
+        var dir = Path.Combine(root, Regex.Replace(test, @"[^\w.@-]+", "_"));
+        var line = JsonSerializer.Serialize(new { v = 1, kind, step, data, t = DateTime.UtcNow.ToString("o") });
+        lock (Gate)
+        {
+            Directory.CreateDirectory(dir);
+            File.AppendAllText(Path.Combine(dir, "evidence.jsonl"), line + "\n");
+        }
+    }
+
+    internal static string Cut(string s) => s.Length <= Limit ? s : s[..Limit] + $"\n[cut, {s.Length} characters]";
+
+    internal static Dictionary<string, string> Headers(params System.Net.Http.Headers.HttpHeaders?[] all)
+    {
+        var d = new Dictionary<string, string>();
+        foreach (var h in all)
+            if (h is not null)
+                foreach (var kv in h) d[kv.Key] = Secret.Contains(kv.Key) ? "[redacted]" : string.Join(", ", kv.Value);
+        return d;
+    }
+}
+
+/// <summary>Records every request the test client sends to the app, and the app's answer.</summary>
+public sealed class EvidenceHandler : DelegatingHandler
+{
+    protected override async Task<HttpResponseMessage> SendAsync(HttpRequestMessage request, CancellationToken ct)
+    {
+        var requestBody = request.Content is null ? "" : await request.Content.ReadAsStringAsync(ct);
+        var sw = Stopwatch.StartNew();
+        var response = await base.SendAsync(request, ct);
+        if (string.IsNullOrEmpty(Environment.GetEnvironmentVariable("WITNESS_ARTIFACTS"))) return response;
+        await response.Content.LoadIntoBufferAsync(ct);
+        var responseBody = await response.Content.ReadAsStringAsync(ct);
+        WitnessEvidence.Record("http", new
+        {
+            method = request.Method.Method,
+            url = request.RequestUri?.ToString(),
+            status = (int)response.StatusCode,
+            ms = sw.ElapsedMilliseconds,
+            request = new { headers = WitnessEvidence.Headers(request.Headers, request.Content?.Headers), body = WitnessEvidence.Cut(Regex.Replace(requestBody, @"(__RequestVerificationToken=)[^&]+", "$1[redacted]")) },
+            response = new { headers = WitnessEvidence.Headers(response.Headers, response.Content.Headers), body = WitnessEvidence.Cut(responseBody) },
+        });
+        return response;
+    }
+}
