+    /// <summary>Witness evidence: a screenshot of the page and a ui observation for this step of the running test. A no-op outside a witness run.</summary>
+    public async Task RecordStepAsync(IPage page, string step, string action, string? target = null, string? value = null)
+    {
+        var root = Environment.GetEnvironmentVariable("WITNESS_ARTIFACTS");
+        var test = TestContext.Current.Test?.TestDisplayName;
+        if (string.IsNullOrEmpty(root) || test is null) return;
+        var dir = Path.Combine(root, Regex.Replace(test, @"[^\w.@-]+", "_"));
+        Directory.CreateDirectory(dir);
+        var shot = $"{Directory.GetFiles(dir, "*.png").Length + 1:D2}-{Regex.Replace(step, @"[^\w]+", "-").Trim('-').ToLowerInvariant()}.png";
+        await page.ScreenshotAsync(new PageScreenshotOptions { Path = Path.Combine(dir, shot) });
+        var line = JsonSerializer.Serialize(new { v = 1, kind = "ui", step, files = new[] { shot }, data = new { action, target, value, url = page.Url } });
+        await File.AppendAllTextAsync(Path.Combine(dir, "evidence.jsonl"), line + "\n");
+    }
+
