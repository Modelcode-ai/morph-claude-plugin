From: dserebro <dserebro@modelcode.ai>
Date: Mon, 23 Nov 2026 08:40:54 -0800
Subject: [PATCH 1/7] witness eval: config generated by witness init, completed
 for docker-based dotnet (SDK 11 image)

---
 .witness/.gitignore   |  7 +++++
 .witness/dotnet       | 21 +++++++++++++++
 .witness/witness.toml | 59 +++++++++++++++++++++++++++++++++++++++++++
 3 files changed, 87 insertions(+)
 create mode 100644 .witness/.gitignore
 create mode 100755 .witness/dotnet
 create mode 100644 .witness/witness.toml

diff --git a/.witness/.gitignore b/.witness/.gitignore
new file mode 100644
index 0000000..a19c8ce
--- /dev/null
+++ b/.witness/.gitignore
@@ -0,0 +1,7 @@
+runs/
+check/
+cache/
+up/
+up.json
+run.lock
+.env
diff --git a/.witness/dotnet b/.witness/dotnet
new file mode 100755
index 0000000..7109f57
--- /dev/null
+++ b/.witness/dotnet
@@ -0,0 +1,21 @@
+#!/bin/sh
+# dotnet from the SDK 11 image (the host has SDK 10). The checkout is mounted at its own path so host paths in args stay valid.
+# DOTNET_PUBLISH=<port> publishes that port on 127.0.0.1. Env vars matching FORWARD are passed into the container.
+root=$(cd "$(dirname "$0")/.." && pwd)
+FORWARD='^(WITNESS_[A-Z0-9_]*|ASPNETCORE_[A-Za-z0-9_]*|UseOnlyInMemoryDatabase|baseUrls__[A-Za-z0-9_]*|ESHOP_[A-Za-z0-9_]*)='
+envfile=$(mktemp "${TMPDIR:-/tmp}/witness-dn-env.XXXXXX")
+env | grep -E "$FORWARD" > "$envfile"
+name="witness-dn-$$-$(date +%s)"
+publish=""
+[ -n "$DOTNET_PUBLISH" ] && publish="-p 127.0.0.1:$DOTNET_PUBLISH:$DOTNET_PUBLISH"
+cleanup() { docker rm -f "$name" >/dev/null 2>&1; rm -f "$envfile"; }
+trap 'cleanup; exit 143' TERM INT
+docker run --rm --init --name "$name" $publish --env-file "$envfile" \
+  -e DOTNET_CLI_TELEMETRY_OPTOUT=1 -e DOTNET_NOLOGO=1 -e DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
+  -v "$root:$root" -v eshop-nuget:/root/.nuget/packages -w "$PWD" \
+  mcr.microsoft.com/dotnet/sdk:11.0 dotnet "$@" &
+child=$!
+wait $child
+code=$?
+cleanup
+exit $code
diff --git a/.witness/witness.toml b/.witness/witness.toml
new file mode 100644
index 0000000..7651e06
--- /dev/null
+++ b/.witness/witness.toml
@@ -0,0 +1,59 @@
+# eShopOnWeb under witness. dotnet runs in the SDK 11 image through .witness/dotnet (the host has SDK 10).
+version = 1
+
+[env]
+file = ".witness/.env"
+required = []
+
+[[service]]
+name = "web"
+cwd = "."
+setup = ".witness/dotnet build src/Web/Web.csproj"
+start = ".witness/dotnet run --no-build --no-launch-profile --project src/Web/Web.csproj --urls http://0.0.0.0:${PORT}"
+env = { UseOnlyInMemoryDatabase = "true", ASPNETCORE_ENVIRONMENT = "Development", DOTNET_PUBLISH = "${PORT}" }
+ready = { http = "${self.url}/home_page_health_check", status = 200, timeout = "180s" }
+
+[[suite]]
+name = "unit"
+adapter = "dotnet"
+cwd = "."
+cmd = ".witness/dotnet test --project tests/UnitTests/UnitTests.csproj"
+service = []
+timeout = "20m"
+
+[[suite]]
+name = "integration"
+adapter = "dotnet"
+cwd = "."
+cmd = ".witness/dotnet test --project tests/IntegrationTests/IntegrationTests.csproj"
+service = []
+timeout = "20m"
+
+[[suite]]
+name = "functional"
+adapter = "dotnet"
+cwd = "."
+cmd = ".witness/dotnet test --project tests/FunctionalTests/FunctionalTests.csproj"
+service = []
+timeout = "20m"
+
+[[suite]]
+name = "publicapi"
+adapter = "dotnet"
+cwd = "."
+cmd = ".witness/dotnet test --project tests/PublicApiIntegrationTests/PublicApiIntegrationTests.csproj"
+service = []
+timeout = "20m"
+
+[[suite]]
+name = "smoke-http"
+adapter = "generic"
+cwd = "."
+cmd = "curl -fsS ${web.url}/ | grep -qi catalog"
+service = ["web"]
+timeout = "2m"
+
+[run]
+stall_timeout = "5m"
+heartbeat = "60s"
+keep_runs = 20
