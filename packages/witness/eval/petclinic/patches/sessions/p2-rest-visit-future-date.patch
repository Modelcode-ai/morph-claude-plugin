+version: 1
+source: "user request (bug report: future visit dates accepted on POST /api/owners/{ownerId}/pets/{petId}/visits and PUT /api/visits/{visitId})"
+items:
+  - id: P1
+    behavior: "POST /api/owners/{ownerId}/pets/{petId}/visits with a date after today is rejected"
+    expect: "400 MethodArgumentNotValidException whose schemaValidationErrors names field 'date'; no visit is saved"
+    kind: new
+    tests: ["junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testCreateVisitWithFutureDateShouldReturnBadRequest"]
+  - id: P2
+    behavior: "PUT /api/visits/{visitId} with a date after today is rejected"
+    expect: "400 MethodArgumentNotValidException whose schemaValidationErrors names field 'date'; the visit is not saved"
+    kind: new
+    tests: ["junit-maven:org.springframework.samples.petclinic.rest.controller.VisitRestControllerV1Tests#testUpdateVisitWithFutureDateShouldReturnBadRequest"]
+  - id: P3
+    behavior: "POST /api/owners/{ownerId}/pets/{petId}/visits still accepts a visit dated today or earlier"
+    expect: "201 Created for a visit dated today and for one dated yesterday"
+    kind: parity
+    tests:
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testCreateVisitSuccess"
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testCreateVisitWithPastDateSuccess"
+  - id: P4
+    behavior: "PUT /api/visits/{visitId} still accepts a visit dated today or earlier"
+    expect: "204 for a visit dated today and for one dated yesterday, and the saved visit carries the sent date"
+    kind: parity
+    tests:
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.VisitRestControllerV1Tests#testUpdateVisitSuccess"
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.VisitRestControllerV1Tests#testUpdateVisitWithPastDateSuccess"
+  - id: P5
+    behavior: "POST /api/visits with a date after today is rejected too (not in the request: it shares the VisitFields schema)"
+    expect: "400 whose schemaValidationErrors names field 'date'; no visit is saved"
+    kind: new
+    tests: ["junit-maven:org.springframework.samples.petclinic.rest.controller.VisitRestControllerV1Tests#testCreateVisitWithFutureDateShouldReturnBadRequest"]
+  - id: P6
+    behavior: "Scheduling a visit with a past date still works end to end against the running app"
+    expect: "the visit is registered and the response carries its id, the pet id and the date that was sent"
+    kind: parity
+    tests:
+      - "generic:01FirstVisitScheduleAVisit#Visit register contains a ID , petId is equal to the expected? Date matches to the expected?"
+      - "generic:02ReturningCustomerScheduleANewVisit#Visit register contains a ID , petId is equal to the expected? Date matches to the expected?"
