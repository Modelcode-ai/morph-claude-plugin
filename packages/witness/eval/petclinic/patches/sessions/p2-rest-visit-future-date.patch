diff --git a/src/test/java/org/springframework/samples/petclinic/rest/controller/WitnessEvidence.java b/src/test/java/org/springframework/samples/petclinic/rest/controller/WitnessEvidence.java
new file mode 100644
index 0000000..e33dfeb
--- /dev/null
+++ b/src/test/java/org/springframework/samples/petclinic/rest/controller/WitnessEvidence.java
@@ -0,0 +1,70 @@
+package org.springframework.samples.petclinic.rest.controller;
+
+import org.springframework.mock.web.MockHttpServletRequest;
+import org.springframework.mock.web.MockHttpServletResponse;
+import org.springframework.test.web.servlet.ResultHandler;
+import tools.jackson.databind.ObjectMapper;
+
+import java.io.IOException;
+import java.io.UncheckedIOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.Collections;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+/**
+ * Records each MockMvc exchange as witness evidence when the tests run under witness
+ * (WITNESS_ARTIFACTS set). Does nothing otherwise and never changes the exchange.
+ */
+final class WitnessEvidence {
+
+    private static final int MAX_BODY = 64 * 1024;
+    private static final ObjectMapper MAPPER = new ObjectMapper();
+
+    private WitnessEvidence() {
+    }
+
+    static ResultHandler recorder(String testName) {
+        return result -> {
+            String root = System.getenv("WITNESS_ARTIFACTS");
+            if (root == null || root.isEmpty() || testName == null) {
+                return;
+            }
+            MockHttpServletRequest request = result.getRequest();
+            MockHttpServletResponse response = result.getResponse();
+            String query = request.getQueryString();
+            Map<String, Object> data = new LinkedHashMap<>();
+            data.put("method", request.getMethod());
+            data.put("url", request.getRequestURI() + (query == null ? "" : "?" + query));
+            data.put("status", response.getStatus());
+            data.put("request", Collections.singletonMap("body", cut(bodyOf(request.getContentAsByteArray()))));
+            data.put("response", Collections.singletonMap("body", cut(response.getContentAsString(StandardCharsets.UTF_8))));
+            Map<String, Object> line = new LinkedHashMap<>();
+            line.put("v", 1);
+            line.put("kind", "http");
+            line.put("data", data);
+            Path folder = Path.of(root, testName.replaceAll("[^A-Za-z0-9_.@-]", "_"));
+            try {
+                Files.createDirectories(folder);
+                Files.writeString(folder.resolve("evidence.jsonl"), MAPPER.writeValueAsString(line) + "\n",
+                    StandardCharsets.UTF_8, StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+            } catch (IOException e) {
+                throw new UncheckedIOException(e);
+            }
+        };
+    }
+
+    private static String bodyOf(byte[] content) {
+        return content == null ? null : new String(content, StandardCharsets.UTF_8);
+    }
+
+    private static String cut(String body) {
+        if (body == null || body.length() <= MAX_BODY) {
+            return body;
+        }
+        return body.substring(0, MAX_BODY) + "... [cut " + (body.length() - MAX_BODY) + " chars]";
+    }
+}
