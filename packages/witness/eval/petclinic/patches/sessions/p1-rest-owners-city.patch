+#!/bin/sh
+# Runs the Postman collection with newman against $1 (base URL), writes JUnit to $WITNESS_REPORT_DIR/newman.xml,
+# and, under witness, turns newman's JSON report into evidence (.witness/newman-evidence.js). Exit code is newman's.
+: "${1:?usage: .witness/newman <baseUrl>}"
+root=$(cd "$(dirname "$0")/.." && pwd)
+json="$root/.witness/scratch/newman-$$.json"; mkdir -p "$root/.witness/scratch"
+npx -y -p newman newman run "$root/src/test/postman/petclinic-nonregressiontests.postman_collection.json" \
+  -e "$root/src/test/postman/petclinic-env.postman_environment.json" --env-var "baseUrl=$1" --timeout-request 5000 \
+  -r cli,junit,json --reporter-junit-export "${WITNESS_REPORT_DIR:-$root/.witness/scratch}/newman.xml" --reporter-json-export "$json"
+code=$?
+[ -n "$WITNESS_ARTIFACTS" ] && [ -f "$json" ] && node "$root/.witness/newman-evidence.js" "$json" "$WITNESS_ARTIFACTS"
+rm -f "$json"
+exit $code
diff --git a/.witness/newman-evidence.js b/.witness/newman-evidence.js
new file mode 100644
index 0000000..dd4dc4a
--- /dev/null
+++ b/.witness/newman-evidence.js
@@ -0,0 +1,31 @@
+// Writes witness evidence for each newman assertion: <artifacts>/<test id>/evidence.jsonl,
+// where the test id is the JUnit classname newman reports (folder + request name, camel-cased) + "#" + assertion.
+const fs = require('fs');
+const path = require('path');
+const [jsonFile, artifacts] = process.argv.slice(2);
+const run = JSON.parse(fs.readFileSync(jsonFile, 'utf8')).run;
+const MAX = 64 * 1024;
+const cut = (s) => (s.length <= MAX ? s : s.slice(0, MAX) + `... [cut ${s.length - MAX} chars]`);
+const camel = (s) => s.split(/\s+/).map((w) => (w ? w[0].toUpperCase() + w.slice(1) : '')).join('').replace(/[^A-Za-z0-9]/g, '');
+const parents = {};
+const walk = (items, prefix) => items.forEach((it) => (it.item ? walk(it.item, prefix + it.name + ' ') : (parents[it.id] = prefix)));
+walk(JSON.parse(fs.readFileSync(jsonFile, 'utf8')).collection.item, '');
+const redact = (headers) => (headers || []).map((h) => (/^(authorization|cookie|set-cookie|x-api-key)$/i.test(h.key) ? { ...h, value: '[redacted]' } : h));
+for (const ex of run.executions) {
+  const req = ex.request || {};
+  const res = ex.response || {};
+  const url = typeof req.url === 'string' ? req.url
+    : `${req.url.protocol}://${req.url.host.join('.')}${req.url.port ? ':' + req.url.port : ''}/${req.url.path.join('/')}`
+      + (req.url.query && req.url.query.length ? '?' + req.url.query.map((q) => `${q.key}=${q.value}`).join('&') : '');
+  const body = res.stream ? Buffer.from(res.stream.data || res.stream).toString('utf8') : '';
+  const http = { v: 1, kind: 'http', data: { method: req.method, url, status: res.code, ms: res.responseTime,
+    request: { headers: redact(req.header), body: cut((req.body && req.body.raw) || '') },
+    response: { headers: redact(res.header), body: cut(body) } } };
+  const classname = camel((parents[ex.item.id] || '') + ex.item.name);
+  for (const a of ex.assertions || []) {
+    const dir = path.join(artifacts, `${classname}#${a.assertion}`.replace(/[^A-Za-z0-9_.@-]/g, '_'));
+    fs.mkdirSync(dir, { recursive: true });
+    const check = { v: 1, kind: 'check', data: { what: a.assertion, ok: !a.error, actual: a.error ? a.error.message : undefined } };
+    fs.appendFileSync(path.join(dir, 'evidence.jsonl'), JSON.stringify(http) + '\n' + JSON.stringify(check) + '\n');
+  }
+}
