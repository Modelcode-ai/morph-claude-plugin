@@ -0,0 +1,62 @@
+package org.springframework.samples.petclinic.rest;
+
+import java.io.IOException;
+import java.nio.charset.StandardCharsets;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.nio.file.StandardOpenOption;
+import java.util.LinkedHashMap;
+import java.util.Map;
+
+import com.fasterxml.jackson.databind.ObjectMapper;
+import org.junit.jupiter.api.TestInfo;
+import org.springframework.test.web.servlet.ResultHandler;
+
+/**
+ * Records each MockMvc exchange as witness evidence (WITNESS_ARTIFACTS/&lt;test id&gt;/evidence.jsonl).
+ * Does nothing when the tests run outside witness.
+ */
+public final class WitnessEvidence {
+
+    private static final int MAX_BODY = 64 * 1024;
+
+    private static final ObjectMapper MAPPER = new ObjectMapper();
+
+    private WitnessEvidence() {
+    }
+
+    public static ResultHandler recordHttp(TestInfo testInfo) {
+        return result -> {
+            String root = System.getenv("WITNESS_ARTIFACTS");
+            if (root == null || root.isEmpty() || testInfo.getTestClass().isEmpty() || testInfo.getTestMethod().isEmpty()) {
+                return;
+            }
+            String testId = testInfo.getTestClass().get().getName() + "#" + testInfo.getTestMethod().get().getName();
+            var request = result.getRequest();
+            var response = result.getResponse();
+            String url = request.getRequestURI() + (request.getQueryString() != null ? "?" + request.getQueryString() : "");
+            Map<String, Object> data = new LinkedHashMap<>();
+            data.put("method", request.getMethod());
+            data.put("url", url);
+            data.put("status", response.getStatus());
+            byte[] requestBody = request.getContentAsByteArray();
+            data.put("request", Map.of("body", cut(requestBody == null ? "" : new String(requestBody, StandardCharsets.UTF_8))));
+            data.put("response", Map.of("body", cut(new String(response.getContentAsByteArray(), StandardCharsets.UTF_8))));
+            append(root, testId, Map.of("v", 1, "kind", "http", "data", data));
+        };
+    }
+
+    private static String cut(String body) {
+        if (body == null) {
+            return "";
+        }
+        return body.length() <= MAX_BODY ? body : body.substring(0, MAX_BODY) + "... [cut " + (body.length() - MAX_BODY) + " chars]";
+    }
+
+    private static void append(String root, String testId, Map<String, Object> line) throws IOException {
+        Path folder = Path.of(root, testId.replaceAll("[^A-Za-z0-9_.@-]", "_"));
+        Files.createDirectories(folder);
+        Files.writeString(folder.resolve("evidence.jsonl"), MAPPER.writeValueAsString(line) + "\n",
+            StandardCharsets.UTF_8, StandardOpenOption.CREATE, StandardOpenOption.APPEND);
+    }
+}
