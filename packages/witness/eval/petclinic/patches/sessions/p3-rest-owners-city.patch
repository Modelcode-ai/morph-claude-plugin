@@ -0,0 +1,44 @@
+version: 1
+source: "user request (add an optional city query parameter to GET /api/owners: case-insensitive, whole city name, combinable with lastName, 404 when nothing matches like today)"
+items:
+  - id: B1
+    behavior: "GET /api/owners?city=<city> returns only the owners who live in that city, matching the city name in any case"
+    expect: "200 with exactly the owners whose city equals the given name ignoring case (city=madison returns the 4 seeded Madison owners; city=sun PRAIRIE returns Betty Davis)"
+    kind: new
+    tests:
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testGetOwnersByCityIgnoresCase"
+      - "generic:03OwnerSearchByCityFindOwnersByCityIgnoringCase#Only the seeded Madison owners are returned"
+  - id: B2
+    behavior: "The city filter matches the whole city name only, not a prefix or part of it"
+    expect: "404 for city=Mad and city=Sun, although owners live in Madison and Sun Prairie"
+    kind: new
+    tests:
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testGetOwnersByPartialCityNotFound"
+      - "generic:03OwnerSearchByCityFindOwnersByPartialCityName#A partial city name matches nobody: 404"
+  - id: B3
+    behavior: "city combines with lastName: only owners matching both are returned"
+    expect: "200; lastName=Davis&city=SUN PRAIRIE returns only Betty Davis, lastName=Davis&city=windsor only Harold Davis"
+    kind: new
+    tests:
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testGetOwnersByLastNameAndCity"
+      - "generic:03OwnerSearchByCityFindOwnersByLastNameAndCity#Only Betty Davis of Sun Prairie is returned, not Harold Davis of Windsor"
+  - id: B4
+    behavior: "When no owner matches lastName and city together, the endpoint answers 404 as it does today"
+    expect: "404 for lastName=Davis&city=Madison (Davises exist, Madison owners exist, none both)"
+    kind: new
+    tests:
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testGetOwnersByLastNameAndCityNotFound"
+      - "generic:03OwnerSearchByCityFindOwnersByLastNameAndCityWithNoMatch#No Davis lives in Madison: 404"
+  - id: B5
+    behavior: "GET /api/owners?lastName=<prefix> without city still returns owners by last-name prefix, and 404 when none match"
+    expect: "200 with Betty and Harold Davis for lastName=Davis; 404 for lastName=0"
+    kind: parity
+    tests:
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testGetOwnersListSuccess"
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testGetOwnersListNotFound"
+  - id: B6
+    behavior: "GET /api/owners without parameters still lists all owners"
+    expect: "200 with every owner"
+    kind: parity
+    tests:
+      - "junit-maven:org.springframework.samples.petclinic.rest.controller.OwnerRestControllerV1Tests#testGetAllOwnersSuccess"
diff --git a/src/main/java/org/springframework/samples/petclinic/rest/controller/v1/OwnerRestControllerV1.java b/src/main/java/org/springframework/samples/petclinic/rest/controller/v1/OwnerRestControllerV1.java
index 5a62a9e..cddfa31 100644
--- a/src/main/java/org/springframework/samples/petclinic/rest/controller/v1/OwnerRestControllerV1.java
+++ b/src/main/java/org/springframework/samples/petclinic/rest/controller/v1/OwnerRestControllerV1.java
@@ -73,13 +73,19 @@ public class OwnerRestControllerV1 implements OwnersApi {
 
     @PreAuthorize("hasRole(@roles.OWNER_ADMIN)")
     @Override
-    public ResponseEntity<List<OwnerDto>> listOwners(String lastName) {
+    public ResponseEntity<List<OwnerDto>> listOwners(String lastName, String city) {
         Collection<Owner> owners;
         if (lastName != null) {
             owners = this.clinicService.findOwnerByLastName(lastName);
         } else {
             owners = this.clinicService.findAllOwners();
         }
+        if (city != null && !city.isBlank()) {
+            String wanted = city.trim();
+            owners = owners.stream()
+                .filter(owner -> owner.getCity() != null && owner.getCity().trim().equalsIgnoreCase(wanted))
+                .toList();
+        }
         if (owners.isEmpty()) {
             return new ResponseEntity<>(HttpStatus.NOT_FOUND);
         }
