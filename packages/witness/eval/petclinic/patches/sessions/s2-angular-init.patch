diff --git a/e2e-live/backend.e2e-spec.ts b/e2e-live/backend.e2e-spec.ts
new file mode 100644
index 0000000..15eb86d
--- /dev/null
+++ b/e2e-live/backend.e2e-spec.ts
@@ -0,0 +1,17 @@
+import { expect, test } from '@playwright/test';
+
+// These tests run against the real spring-petclinic-rest backend and its seeded H2 data (no
+// mocks). Witness runs them (suite playwright-live); CI's `npm run e2e` covers only ./e2e.
+
+test('lists the backend seed data on the vets and owners pages', async ({ page }) => {
+  const vetsResponse = page.waitForResponse(response => response.url().endsWith('/petclinic/api/vets'));
+  await page.goto('/petclinic/vets');
+  expect((await vetsResponse).status()).toBe(200);
+  await expect(page.locator('#vets')).toContainText('James Carter');
+  await expect(page.locator('#vets')).toContainText('Sharon Jenkins');
+
+  await page.goto('/petclinic/owners');
+  await page.locator('#lastName').fill('Franklin');
+  await page.getByRole('button', { name: 'Find Owner' }).click();
+  await expect(page.getByRole('link', { name: 'George Franklin' })).toBeVisible();
+});
