--- /dev/null
+++ b/.witness/witness.example.toml
@@ -0,0 +1,42 @@
+# Witness config (version 1). Generated by `witness init` from the files in this repo: review it,
+# then save it as .witness/witness.toml. Run `witness check` to try it.
+# Witness runs functional tests only: tests that drive the app over HTTP (kind = "api"), in a browser
+# ("ui"), through its built command ("cli"), its window ("desktop") or on a device ("mobile").
+# Unit and integration tests stay with the project's own build and test scripts.
+version = 1
+
+[env]
+file = ".witness/.env"        # KEY=VALUE lines, gitignored
+required = []                 # names that must be set, e.g. ["DATABASE_URL"]
+
+# [[dependency]]
+# name = "postgres"
+# check = "pg_isready -h localhost"
+# start = "docker compose up -d db"
+# timeout = "60s"
+
+# start script in package.json; commented out: every proposed suite starts the app itself, so nothing uses it
+# [[service]]
+# name = "web"
+# cwd = "."
+# setup = "npm ci"
+# start = "npm start"
+# ready = { http = "${self.url}/", timeout = "180s" }
+
+# e2e: 1 test file(s) drive the app (Playwright webServer, browser driver, localhost URL)
+[[suite]]
+name = "playwright"
+kind = "ui"
+adapter = "playwright"
+cwd = "."
+cmd = "npx playwright test"
+service = []                 # the tests start the app themselves
+timeout = "20m"
+
+# Not proposed: these test projects don't drive the app through its HTTP API, UI, command line, window or device.
+#   . (vitest): unit (no app host, HTTP client, browser driver or run of the app's command)
+
+[run]
+stall_timeout = "5m"
+heartbeat = "60s"
+keep_runs = 10
diff --git a/.witness/witness.toml b/.witness/witness.toml
new file mode 100644
index 0000000..d759991
--- /dev/null
+++ b/.witness/witness.toml
@@ -0,0 +1,68 @@
+# Witness config (version 1). Run `witness check` to try it.
+# Witness runs functional tests only; the vitest unit tests (`npm run test:ci`) stay with the
+# project's own build.
+version = 1
+
+[env]
+file = ".witness/.env"        # KEY=VALUE lines, gitignored
+required = []
+# The real backend, from its own witness config (Docker, petclinic-eval-* containers, ports
+# 19966-19975, never 9966). Only web-live uses it: the mocked playwright suite needs no backend,
+# its tests mock every call to http://localhost:9966/petclinic/api (e2e/app.e2e-spec.ts:53).
+[[repo]]
+name = "backend"
+path = "../spring-petclinic-rest"
+services = ["app"]
+suites = []
+
+# The Angular dev server on a port witness assigns (never 4200: other apps on this machine use it).
+[[service]]
+name = "web"
+cwd = "."
+setup = "npm ci"
+start = "npm start -- --host 127.0.0.1 --port ${PORT}"
+ready = { http = "${self.url}/", timeout = "180s" }
+
+# The same dev server wired to the real backend: `--configuration witness` swaps in
+# src/environments/environment.witness.ts (relative /petclinic/api/), and a proxy file written at
+# start forwards /petclinic/api (not the app's own /petclinic/* pages) to the backend's port
+# (user's choice over a test-side redirect).
+[[service]]
+name = "web-live"
+cwd = "."
+setup = "npm ci"
+start = "printf '{\"/petclinic/api\": {\"target\": \"%s\", \"secure\": false, \"changeOrigin\": true}}' \"$BACKEND_URL\" > .witness/scratch/proxy.live.json && exec npm start -- --configuration witness --proxy-config .witness/scratch/proxy.live.json --host 127.0.0.1 --port ${PORT}"
+env = { BACKEND_URL = "${backend.app.url}" }
+depends_on = ["backend.app"]
+ready = { http = "${self.url}/petclinic/api/vets", timeout = "180s" }   # answers only through the proxy, once the backend is up
+
+# e2e: Playwright against the witness-started app. .witness/playwright.witness.config.ts reuses
+# playwright.config.ts but drops its webServer on port 4200 and records screenshots and video.
+[[suite]]
+name = "playwright"
+kind = "ui"
+adapter = "playwright"
+cwd = "."
+cmd = "npx playwright test --config .witness/playwright.witness.config.ts"
+service = ["web"]
+timeout = "20m"
+per_test_timeout = "60s"
+
+# e2e-live: browser tests against the real backend (user's choice: own folder, so CI's
+# `npm run e2e`, which has no backend, never runs them).
+[[suite]]
+name = "playwright-live"
+kind = "ui"
+adapter = "playwright"
+cwd = "."
+cmd = "npx playwright test --config .witness/playwright.live.witness.config.ts"
+service = ["web-live"]
+timeout = "20m"
+per_test_timeout = "60s"
+
+# Not a suite: . (vitest) unit tests, no app host or browser.
+
+[run]
+stall_timeout = "5m"
+heartbeat = "60s"
+keep_runs = 10
