+// Witness-only Playwright config for the e2e-live tests: the repo's playwright.config.ts pointed at
+// web-live (the dev server proxied to the real backend), with screenshot, video and trace on.
+import { defineConfig } from '@playwright/test';
+import base from '../playwright.config';
+
+const baseURL = process.env.WITNESS_WEB_LIVE_URL;
+if (!baseURL) {
+  throw new Error('WITNESS_WEB_LIVE_URL is not set: run this config through witness');
+}
+
+export default defineConfig({
+  ...base,
+  testDir: '../e2e-live',
+  webServer: undefined,
+  outputDir: 'scratch/test-results-live', // git-ignored
+  use: {
+    ...base.use,
+    baseURL,
+    screenshot: 'on',
+    video: 'on',
+    trace: 'on'
+  }
+});
diff --git a/.witness/playwright.witness.config.ts b/.witness/playwright.witness.config.ts
new file mode 100644
index 0000000..d164be1
--- /dev/null
+++ b/.witness/playwright.witness.config.ts
@@ -0,0 +1,25 @@
+// Witness-only Playwright config: the repo's playwright.config.ts with two changes.
+// - The app is the one witness started (WITNESS_WEB_URL), not a webServer on the hardcoded
+//   port 4200, which other apps on this machine may hold (reuseExistingServer would reuse them).
+// - Screenshot, video and trace for every test, so witness reports show what each test saw.
+import { defineConfig } from '@playwright/test';
+import base from '../playwright.config';
+
+const baseURL = process.env.WITNESS_WEB_URL;
+if (!baseURL) {
+  throw new Error('WITNESS_WEB_URL is not set: run this config through witness');
+}
+
+export default defineConfig({
+  ...base,
+  testDir: '../e2e',
+  webServer: undefined,
+  outputDir: 'scratch/test-results', // git-ignored, instead of ./test-results at the repo root
+  use: {
+    ...base.use,
+    baseURL,
+    screenshot: 'on',
+    video: 'on',
+    trace: 'on'
+  }
+});
