diff --git a/.witness/plan.yaml b/.witness/plan.yaml
new file mode 100644
index 0000000..e97f812
--- /dev/null
+++ b/.witness/plan.yaml
@@ -0,0 +1,36 @@
+version: 1
+source: "user request (City search next to the last-name search on the Owners page: shows only the owners who live in the city, combines with the last name; backend GET /api/owners gets an optional city parameter, case-insensitive, whole city name, 404 when nothing matches)"
+items:
+  - id: A1
+    behavior: "The Owners page has a City field next to Last name; searching a city shows only the owners who live there, whatever the letter case typed"
+    expect: "City 'madison' against the real backend lists exactly George Franklin, Peter McTavish, Maria Escobito and David Schroeder, every row in Madison"
+    kind: new
+    tests:
+      - "playwright:backend.e2e-spec.ts > the City search shows only the owners living in that city, in any letter case"
+  - id: A2
+    behavior: "The City search combines with the Last name search"
+    expect: "Last name 'Davis' + City 'Sun Prairie' lists only Betty Davis (not Harold Davis of Windsor); the request sent carries both lastName and city"
+    kind: new
+    tests:
+      - "playwright:backend.e2e-spec.ts > the City search combines with the last name"
+      - "playwright:app.e2e-spec.ts > searches owners by city together with the last name"
+  - id: A3
+    behavior: "When no owner matches, the page says so and shows no table; a partial city name matches nobody"
+    expect: "City 'Mad' shows 'No owners living in \"Mad\"'; Davis + Madison shows 'No owners with LastName starting with \"Davis\" living in \"Madison\"'; #ownersTable absent"
+    kind: new
+    tests:
+      - "playwright:backend.e2e-spec.ts > the City search matches the whole city name and says so when nobody matches"
+      - "playwright:app.e2e-spec.ts > searches owners by city together with the last name"
+  - id: A4
+    behavior: "Last-name search alone works as before, including its no-results message"
+    expect: "Franklin finds George Franklin on the real backend; 'Unknown' shows 'No owners with LastName starting with \"Unknown\"'"
+    kind: parity
+    tests:
+      - "playwright:backend.e2e-spec.ts > lists the backend seed data on the vets and owners pages"
+      - "playwright:app.e2e-spec.ts > displays message when owner search returns no results"
+  - id: A5
+    behavior: "The Owners page with no search still lists all owners"
+    expect: "the owners list page shows the owners from the backend"
+    kind: parity
+    tests:
+      - "playwright:app.e2e-spec.ts > displays backend data on list pages"
diff --git a/e2e-live/backend.e2e-spec.ts b/e2e-live/backend.e2e-spec.ts
index 15eb86d..3db9a4e 100644
--- a/e2e-live/backend.e2e-spec.ts
+++ b/e2e-live/backend.e2e-spec.ts
@@ -15,3 +15,47 @@ test('lists the backend seed data on the vets and owners pages', async ({ page }
   await page.getByRole('button', { name: 'Find Owner' }).click();
   await expect(page.getByRole('link', { name: 'George Franklin' })).toBeVisible();
 });
+
+// Seeded owners (spring-petclinic-rest db/h2/data.sql): Madison is home to George Franklin, Peter
+// McTavish, Maria Escobito and David Schroeder; Betty Davis lives in Sun Prairie, Harold Davis in
+// Windsor.
+
+test('the City search shows only the owners living in that city, in any letter case', async ({ page }) => {
+  await page.goto('/petclinic/owners');
+  await expect(page.locator('.ownerFullName')).not.toHaveCount(0);
+
+  await page.locator('#city').fill('madison');
+  const response = page.waitForResponse(r => r.url().includes('/petclinic/api/owners?'));
+  await page.getByRole('button', { name: 'Find Owner' }).click();
+  expect((await response).status()).toBe(200);
+
+  await expect(page.locator('.ownerFullName')).toHaveCount(4);
+  const names = (await page.locator('.ownerFullName').allTextContents()).map(n => n.trim()).sort();
+  expect(names).toEqual(['David Schroeder', 'George Franklin', 'Maria Escobito', 'Peter McTavish']);
+  const cities = page.locator('#ownersTable tbody > tr > td:nth-child(3)');
+  await expect(cities).toHaveText(['Madison', 'Madison', 'Madison', 'Madison']);
+});
+
+test('the City search combines with the last name', async ({ page }) => {
+  await page.goto('/petclinic/owners');
+  await page.locator('#lastName').fill('Davis');
+  await page.locator('#city').fill('Sun Prairie');
+  await page.getByRole('button', { name: 'Find Owner' }).click();
+
+  await expect(page.locator('.ownerFullName')).toHaveText(['Betty Davis']);
+  await expect(page.getByRole('link', { name: 'Harold Davis' })).toHaveCount(0);
+});
+
+test('the City search matches the whole city name and says so when nobody matches', async ({ page }) => {
+  await page.goto('/petclinic/owners');
+  await page.locator('#city').fill('Mad');
+  await page.getByRole('button', { name: 'Find Owner' }).click();
+  await expect(page.getByText('No owners living in "Mad"')).toBeVisible();
+  await expect(page.locator('#ownersTable')).toHaveCount(0);
+
+  await page.locator('#lastName').fill('Davis');
+  await page.locator('#city').fill('Madison');
+  await page.getByRole('button', { name: 'Find Owner' }).click();
+  await expect(page.getByText('No owners with LastName starting with "Davis" living in "Madison"')).toBeVisible();
+  await expect(page.locator('#ownersTable')).toHaveCount(0);
+});
