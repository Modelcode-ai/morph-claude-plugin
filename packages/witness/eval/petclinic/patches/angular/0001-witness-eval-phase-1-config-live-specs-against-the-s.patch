diff --git a/.witness/witness.toml b/.witness/witness.toml
new file mode 100644
index 0000000..697dbe7
--- /dev/null
+++ b/.witness/witness.toml
@@ -0,0 +1,47 @@
+# Spring PetClinic Angular under witness. The upstream e2e specs mock the REST API in the browser (page.route), so no backend runs here.
+version = 1
+
+[env]
+file = ".witness/.env"
+required = []
+
+[[service]]
+name = "web"
+cwd = "."
+setup = "npm ci --no-audit --no-fund"
+start = "npx ng serve --host 127.0.0.1 --port ${PORT}"
+ready = { http = "${self.url}/", timeout = "180s" }
+
+# The REST backend from the sibling checkout; its own .witness/ wrappers build and run it in Docker.
+[[service]]
+name = "api"
+cwd = "../spring-petclinic-rest-witness-eval"
+setup = ".witness/mvn -B -q -Dmaven.test.skip=true package"
+start = ".witness/app"
+ready = { http = "${self.url}/petclinic/actuator/health", timeout = "180s" }
+
+# vitest (.): unit tests, left out
+[[suite]]
+name = "e2e"
+kind = "ui"
+adapter = "playwright"
+cwd = "."
+cmd = "npx playwright test -c .witness/playwright.config.ts"
+service = ["web"]
+timeout = "20m"
+per_test_timeout = "60s"
+
+[[suite]]
+name = "e2e-live"
+kind = "ui"
+adapter = "playwright"
+cwd = "."
+cmd = "npx playwright test -c .witness/playwright.live.config.ts"
+service = ["web", "api"]
+timeout = "20m"
+per_test_timeout = "60s"
+
+[run]
+stall_timeout = "5m"
+heartbeat = "60s"
+keep_runs = 30
diff --git a/e2e-live/owners.live.spec.ts b/e2e-live/owners.live.spec.ts
new file mode 100644
index 0000000..12a22a2
--- /dev/null
+++ b/e2e-live/owners.live.spec.ts
@@ -0,0 +1,32 @@
+import { expect, test } from '@playwright/test';
+
+// The app calls http://localhost:9966/petclinic/api/ (environment.ts); forward those calls to the backend witness started.
+test.beforeEach(async ({ page }) => {
+  const api = process.env.WITNESS_API_URL;
+  if (!api) throw new Error('WITNESS_API_URL is not set: these tests need the REST backend');
+  await page.route('http://localhost:9966/petclinic/api/**', async route => {
+    const url = route.request().url().replace('http://localhost:9966', api);
+    await route.fulfill({ response: await route.fetch({ url }) });
+  });
+});
+
+test('lists the seeded owners from the REST backend', async ({ page }) => {
+  await page.goto('/petclinic/owners');
+  await expect(page.getByRole('link', { name: 'George Franklin' })).toBeVisible();
+  await expect(page.getByRole('link', { name: 'Jeff Black' })).toBeVisible();
+});
+
+test('a new owner is saved by the REST backend', async ({ page, request }) => {
+  const lastName = `Live${Date.now().toString(36).replace(/[0-9]/g, c => 'abcdefghij'[Number(c)])}`;
+  await page.goto('/petclinic/owners/add');
+  await page.getByLabel('First Name').fill('Ada');
+  await page.getByLabel('Last Name').fill(lastName);
+  await page.getByLabel('Address').fill('1 Main St.');
+  await page.getByLabel('City').fill('Springfield');
+  await page.getByLabel('Telephone').fill('6085551234');
+  await page.getByRole('button', { name: 'Add Owner' }).click();
+  await expect(page.getByRole('link', { name: `Ada ${lastName}` })).toBeVisible();
+  const res = await request.get(`${process.env.WITNESS_API_URL}/petclinic/api/owners?lastName=${lastName}`);
+  expect(res.status()).toBe(200);
+  expect((await res.json()).map((o: { lastName: string }) => o.lastName)).toEqual([lastName]);
+});
